   "source": [
    "def get_innermost_recursive(nested_list):\n",
    "    for item in nested_list:\n",
    "        if isinstance(item, list):\n",
    "            return get_innermost_recursive(item)\n",
    "    return [x + 1 for x in nested_list]\n",
    "\n",
    "nested_data = [1, [2, 3, [4, 5]]]\n",
    "print(get_innermost_recursive(nested_data))"
   ]
