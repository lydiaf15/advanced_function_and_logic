   "source": [
    "def filter_by_threshold(numbers, threshold):\n",
    "    return [num for num in numbers if num <= threshold]\n",
    "\n",
    "my_numbers = [5, 10, 15, 20, 25, 30, 35, 40, 45, 50]\n",
    "user_threshold = 15\n",
    "\n",
    "filtered_list = filter_by_threshold(my_numbers, user_threshold)\n",
    "print(filtered_list)"
   ]
